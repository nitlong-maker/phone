<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>My Phone</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;background:#0e0f13;font-family:-apple-system,"Apple SD Gothic Neo","Noto Sans KR",sans-serif;overflow:hidden}
body{display:flex;align-items:center;justify-content:center}
#phone{position:relative;width:100vw;height:100dvh;overflow:hidden;background:#000;color:#fff;user-select:none}
@media (min-width:500px){#phone{width:390px;height:844px;border-radius:44px;box-shadow:0 0 0 10px #1c1d22,0 20px 60px #000}}
.scr{position:absolute;inset:0;display:none;flex-direction:column}
.scr.on{display:flex}
.bg{background:linear-gradient(160deg,#3a4a8a,#8a5a9a 55%,#e48a8a)}
.sb{height:calc(env(safe-area-inset-top,0px) + 34px);padding:env(safe-area-inset-top,0px) 22px 0;display:flex;justify-content:space-between;align-items:center;font-size:13px;font-weight:600;flex-shrink:0}
.hb{height:22px;display:flex;align-items:center;justify-content:center;flex-shrink:0;cursor:pointer;padding-bottom:env(safe-area-inset-bottom,0px)}
.hb i{width:120px;height:5px;border-radius:3px;background:currentColor;opacity:.5}
/* lock */
#lock .clock{text-align:center;margin-top:40px}
#lock .clock b{font-size:72px;font-weight:300;display:block}
#lock .clock span{font-size:16px;opacity:.9}
.notis{padding:24px 14px 0}
.noti{background:rgba(255,255,255,.22);backdrop-filter:blur(14px);border-radius:16px;padding:11px 14px;margin-bottom:8px;font-size:13px}
.noti .h{display:flex;justify-content:space-between;opacity:.8;font-size:12px;margin-bottom:3px}
.noti .t{font-weight:600}
#pin{position:absolute;inset:0;background:rgba(20,15,40,.92);display:none;flex-direction:column;align-items:center;justify-content:center}
#pin.on{display:flex}
#pin h3{font-weight:500;margin-bottom:22px}
.dots{display:flex;gap:16px;margin-bottom:34px}
.dots i{width:14px;height:14px;border-radius:50%;border:1.5px solid #fff}
.dots i.f{background:#fff}
.dots.shake{animation:sh .35s}
@keyframes sh{25%{transform:translateX(-10px)}75%{transform:translateX(10px)}}
.pad{display:grid;grid-template-columns:repeat(3,72px);gap:16px}
.pad button{height:72px;border-radius:50%;border:0;background:rgba(255,255,255,.15);color:#fff;font-size:28px}
.pad button:active{background:rgba(255,255,255,.4)}
.pad .e{background:none}
#pin small{margin-top:20px;opacity:.7;cursor:pointer}
#swipe{text-align:center;margin-top:auto;padding-bottom:14px;opacity:.8;font-size:13px;cursor:pointer}
/* home */
.widget{margin:22px 18px 0;background:rgba(255,255,255,.2);backdrop-filter:blur(12px);border-radius:22px;padding:20px;text-align:center;font-size:34px;font-weight:700}
.widget small{display:block;font-size:12px;font-weight:400;opacity:.85;margin-bottom:4px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);padding:30px 16px;gap:22px 0}
.app{display:flex;flex-direction:column;align-items:center;gap:6px;font-size:11px;cursor:pointer;position:relative}
.ic{width:56px;height:56px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:28px;position:relative}
.badge{position:absolute;top:-5px;right:-5px;min-width:19px;height:19px;border-radius:10px;background:#f33;color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;padding:0 5px}
.dock{margin:auto 12px 6px;background:rgba(255,255,255,.22);backdrop-filter:blur(14px);border-radius:28px;padding:12px;display:flex;justify-content:space-around}
/* apps */
.app-h{display:flex;align-items:center;padding:6px 14px 10px;font-weight:700;font-size:18px;gap:10px;flex-shrink:0}
.back{cursor:pointer;font-size:22px;padding:0 6px}
.light{background:#fff;color:#111}
.row{display:flex;align-items:center;padding:13px 18px;border-bottom:1px solid #eee;gap:14px}
.av{width:42px;height:42px;border-radius:50%;background:#e4e4ea;display:flex;align-items:center;justify-content:center;font-size:20px}
.row .n{font-weight:600;font-size:16px}.row .s{font-size:12px;color:#888;margin-top:2px}
.row .d{margin-left:auto;font-size:12px;color:#888}
.miss .n{color:#e53935}
.memo{padding:18px 22px;background:#fffbe8;color:#222;flex:1}
.memo h2{font-size:22px;color:#aaa;font-weight:600;margin-bottom:14px}
.memo p{font-size:18px;line-height:1.6}
/* naver */
.nv{padding:22px 18px 0}
.nv .logo{font-size:30px;font-weight:900;color:#03c75a;text-align:center;margin-bottom:14px;letter-spacing:-1px}
.sbox{border:2.5px solid #03c75a;border-radius:26px;height:48px;display:flex;align-items:center;padding:0 18px;color:#999;font-size:15px;cursor:pointer;justify-content:space-between}
.sbox b{color:#03c75a}
.pg{display:grid;grid-template-columns:repeat(5,1fr);gap:16px 0;padding:26px 8px}
.pg div{display:flex;flex-direction:column;align-items:center;gap:6px;font-size:11px;color:#444}
.pg span{width:46px;height:46px;border-radius:14px;background:#f1f3f5;display:flex;align-items:center;justify-content:center;font-size:22px}
.hist{padding:4px 18px}
.hist p{padding:14px 0;border-bottom:1px solid #f0f0f0;font-size:16px;display:flex;justify-content:space-between;color:#222}
.hist p em{font-style:normal;color:#aaa}
.srch{display:flex;align-items:center;gap:10px;padding:8px 14px;flex-shrink:0}
.srch div{flex:1;border:2.5px solid #03c75a;border-radius:22px;height:42px;padding:0 14px;display:flex;align-items:center;color:#999;font-size:15px}
/* kakao */
#kk{background:#b2c7da;color:#111}
#kk .app-h{background:#b2c7da;color:#111}
#msgs{flex:1;overflow-y:auto;padding:6px 12px 12px}
.date{text-align:center;margin:14px auto 10px;font-size:11px;color:#fff;background:rgba(0,0,0,.18);border-radius:12px;padding:4px 12px;width:fit-content}
.m{display:flex;margin:5px 0;gap:8px;align-items:flex-start}
.m.me{justify-content:flex-end}
.m .pf{width:38px;height:38px;border-radius:15px;background:#fff;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.m .nm{font-size:12px;margin-bottom:3px;color:#333}
.bub{max-width:230px;padding:8px 11px;border-radius:4px 14px 14px 14px;background:#fff;font-size:14.5px;line-height:1.4;word-break:break-word}
.me .bub{background:#fee500;border-radius:14px 4px 14px 14px}
.inp{display:flex;gap:8px;padding:8px 10px;background:#fff;flex-shrink:0}
.inp input{flex:1;border:0;background:#f2f2f2;border-radius:18px;padding:10px 14px;font-size:15px;outline:0;font-family:inherit}
.inp button{border:0;background:#fee500;border-radius:18px;padding:0 16px;font-weight:700;font-size:14px;color:#111}
.ph{background:url(data:image/jpeg;base64,) center/cover !important;font-size:0 !important}
.gray{background:#c4c7cc !important;font-size:0 !important}
.i-kk{background:url(data:image/png;base64,) center/cover no-repeat !important}
.i-ig{background:url(data:image/png;base64,) center/cover no-repeat !important}
.i-ph{background:url(data:image/png;base64,) center/cover no-repeat !important}
.i-sf{background:url(data:image/png;base64,) center/cover no-repeat !important}
.i-ms{background:url(data:image/png;base64,) center/cover no-repeat !important}
.i-nt{background:url(data:image/png;base64,) center/cover no-repeat !important}
:root{--poster:url(data:image/jpeg;base64,);--me:url(data:image/jpeg;base64,)}
.ic{filter:drop-shadow(0 2px 3px rgba(0,0,0,.28));transition:transform .12s}
.app:active .ic{transform:scale(.92)}
.av-p,.av-m{background-size:cover;background-position:center;border-radius:50%;flex-shrink:0}
.av-p{background-image:var(--poster)}.av-m{background-image:var(--me)}
.igh{display:flex;justify-content:space-between;align-items:center;padding:4px 16px 8px;border-bottom:1px solid #efefef;flex-shrink:0}
.wm{font:italic 700 28px Georgia,serif;letter-spacing:-.5px}
.igb{flex:1;overflow-y:auto}
.stories{display:flex;gap:14px;padding:12px 14px}
.st{display:flex;flex-direction:column;align-items:center;font-size:11px;gap:4px;position:relative;width:68px}
.ring{width:68px;height:68px;border-radius:50%;padding:3px;background:linear-gradient(45deg,#fdb94a,#f4492f,#d6249f,#8a3ab9)}
.ring.n{background:none}
.ring div{width:100%;height:100%;border-radius:50%;border:2.5px solid #fff}
.plus{position:absolute;top:46px;left:46px;width:20px;height:20px;border-radius:50%;background:#0095f6;border:2px solid #fff;color:#fff;font-style:normal;font-size:14px;line-height:15px;text-align:center;font-weight:700}
.ph2{display:flex;align-items:center;gap:10px;padding:8px 12px;font-weight:600;font-size:14px}
.ph2 .av-p{width:34px;height:34px}
.ph2 .m3{margin-left:auto;cursor:pointer;padding:6px;letter-spacing:1px}
.carw{position:relative;width:100%;aspect-ratio:4/5;background:#eee}
.car{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;width:100%;height:100%;scrollbar-width:none}
.car::-webkit-scrollbar{display:none}
.car img{flex:none;width:100%;height:100%;object-fit:cover;scroll-snap-align:start;-webkit-user-drag:none;pointer-events:none}
.cnt{position:absolute;top:10px;right:10px;background:rgba(0,0,0,.6);color:#fff;font-size:12px;padding:3px 9px;border-radius:12px}
.ar{position:absolute;top:50%;transform:translateY(-50%);width:28px;height:28px;border-radius:50%;border:0;background:rgba(255,255,255,.85);color:#111;font-size:18px;line-height:26px;cursor:pointer;display:none;align-items:center;justify-content:center}
.ar.l{left:8px}.ar.r{right:8px}
.pop{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:90px;opacity:0;pointer-events:none}
.pop.go{animation:pp .7s}
@keyframes pp{20%{opacity:1;transform:scale(1.2)}70%{opacity:1;transform:scale(1)}100%{opacity:0}}
.acts{display:flex;align-items:center;gap:14px;padding:10px 12px 4px}
.acts svg{width:26px;height:26px;fill:none;stroke:#111;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;cursor:pointer}
#hbtn.on{fill:#ed4956;stroke:#ed4956}
.acts .bk{margin-left:auto}
.dti{display:flex;gap:4px;justify-content:center;margin:-26px auto 14px;position:relative;height:6px}
.dti i{width:6px;height:6px;border-radius:50%;background:#c7c7c7}.dti i.on{background:#0095f6}
.likes{font-weight:600;font-size:14px;padding:0 12px}
.cap{font-size:14px;padding:4px 12px}
.tm{font-size:12px;color:#8e8e8e;padding:4px 12px 20px}
#empty{display:none;text-align:center;color:#8e8e8e;padding:70px 0;font-size:14px}
.nav{display:flex;justify-content:space-around;align-items:center;height:48px;border-top:1px solid #efefef;flex-shrink:0;background:#fff}
.nav svg{width:26px;height:26px;stroke:#111;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.nav .av-m{width:26px;height:26px}
.ov{position:absolute;inset:0;background:rgba(0,0,0,.5);display:none;z-index:5}
.ov.on{display:flex}
#sheet{align-items:flex-end}
.sh{background:#fff;width:100%;border-radius:16px 16px 0 0;padding:8px 0 28px;color:#111;text-align:center}
.sh div{padding:15px;font-size:16px;cursor:pointer;border-bottom:1px solid #f0f0f0}
.sh .red{color:#ed4956;font-weight:700}
#dlg{align-items:center;justify-content:center}
.dg{background:#fff;color:#111;width:270px;border-radius:14px;text-align:center;overflow:hidden}
.dg h4{padding:22px 16px 6px;font-size:17px}.dg p{padding:0 16px 18px;font-size:13px;color:#777}
.dg div{padding:13px;border-top:1px solid #eee;font-size:15px;cursor:pointer}
.sr{display:flex;align-items:center;gap:5px;--tx:#222;font-size:12px;font-weight:700}
.light .sr,#kk .sr{--tx:#fff}
.sr svg{width:17px;height:11px;fill:currentColor}
.bt{position:relative;width:28px;height:15px;border-radius:5px;background:linear-gradient(90deg,currentColor 73%,rgba(140,140,140,.55) 73%);display:flex;align-items:center;justify-content:center;margin-right:4px}
.bt::after{content:"";position:absolute;right:-3px;top:5px;width:2px;height:5px;border-radius:0 2px 2px 0;background:rgba(140,140,140,.7)}
.bt em{font-style:normal;font-size:10.5px;font-weight:800;color:var(--tx);letter-spacing:-.3px}
.igh{justify-content:center}
#anx.seen .ring{background:#c7c7c7}
#story{background:#000}
#sbg{position:absolute;inset:0;background:var(--cur,var(--s1)) center/cover;filter:blur(28px) brightness(.6);transform:scale(1.2)}
#simg{position:absolute;inset:0;background:var(--cur,var(--s1)) center/cover no-repeat}
#svid{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#000;display:none}
.sbars{position:absolute;top:calc(env(safe-area-inset-top,0px) + 8px);left:8px;right:8px;display:flex;gap:4px;z-index:4}
.sbars i{flex:1;height:2.5px;background:rgba(255,255,255,.35);border-radius:2px;overflow:hidden}
.sbars b{display:block;height:100%;width:0;background:#fff}
.shead{position:absolute;top:calc(env(safe-area-inset-top,0px) + 20px);left:12px;right:12px;display:flex;align-items:center;gap:8px;z-index:6;font-size:14px;font-weight:600;text-shadow:0 1px 3px rgba(0,0,0,.5)}
.shead #sav{width:32px;height:32px}
.shead em{font-style:normal;font-weight:400;opacity:.8;font-size:13px}
.shead .x{margin-left:auto;font-size:22px;cursor:pointer;padding:4px 6px}
#cf{display:none;align-items:center;gap:3px;background:#1fd15c;color:#fff;font-size:11px;font-weight:700;padding:3px 8px;border-radius:12px;text-shadow:none}
#story.cfs .shead #sav{box-shadow:0 0 0 2px #000,0 0 0 4px #1fd15c}
.tl,.tr{position:absolute;top:70px;bottom:70px;z-index:3}.tl{left:0;width:30%}.tr{right:0;width:70%}
.sinp{position:absolute;left:12px;right:12px;bottom:calc(env(safe-area-inset-bottom,0px) + 14px);z-index:4;border:1px solid rgba(255,255,255,.7);border-radius:24px;padding:11px 16px;font-size:14px;color:rgba(255,255,255,.85);display:flex;justify-content:space-between}
.cav{width:120px;height:120px;border-radius:50%;margin:60px auto 16px}
.cw{text-align:center}.cw h2{font-size:26px;font-weight:600}.cw p{opacity:.75;margin-top:6px;font-size:15px}
.csub{margin:30px 24px 0;min-height:90px;text-align:center;font-size:22px;font-weight:600;line-height:1.4;opacity:0}
.csub.on{animation:fi .4s forwards}.csub small{display:block;font-size:12px;opacity:.6;font-weight:400;margin-bottom:6px}
@keyframes fi{to{opacity:1}}
.cend{margin-top:auto;text-align:center;padding-bottom:48px}
.cend button{width:68px;height:68px;border-radius:50%;border:0;background:#ff3b30;font-size:28px;transform:rotate(135deg)}
:root{--s1:url(data:image/jpeg;base64,)}
.cmv{font-size:14px;color:#8e8e8e;padding:4px 12px 0;cursor:pointer}.cmv:empty{display:none}
.cms{background:#fff;color:#111;width:100%;height:68%;border-radius:16px 16px 0 0;display:flex;flex-direction:column}
.cmh{text-align:center;font-weight:700;font-size:15px;padding:14px 0 12px;border-bottom:1px solid #efefef;position:relative}
.cmh i{position:absolute;top:6px;left:50%;margin-left:-20px;width:40px;height:4px;border-radius:2px;background:#ccc}
.cml{flex:1;overflow-y:auto;padding:10px 14px}
.cme{text-align:center;color:#8e8e8e;font-size:14px;padding:60px 0;line-height:1.6}
.cmi{display:flex;gap:10px;padding:8px 0;font-size:14px;line-height:1.4;word-break:break-word}
.cmi .av-m{width:32px;height:32px;flex-shrink:0}.cmi .cmt{font-size:12px;color:#8e8e8e;margin-top:2px}
.cin{display:flex;align-items:center;gap:10px;padding:10px 14px calc(10px + env(safe-area-inset-bottom,0px));border-top:1px solid #efefef}
.cin .av-m{width:32px;height:32px;flex-shrink:0}
.cin input{flex:1;border:1px solid #dbdbdb;border-radius:20px;padding:9px 14px;font-size:14px;outline:0;font-family:inherit}
.cin button{border:0;background:none;color:#0095f6;font-weight:700;font-size:14px}
:root{--jun:url(data:image/jpeg;base64,);--jio:url(data:image/jpeg;base64,);--s3:url(data:image/jpeg;base64,);--s4:url(data:image/jpeg;base64,);--s5:url(data:image/jpeg;base64,)}
.av-j,.av-i{background-size:cover;background-position:center;border-radius:50%;flex-shrink:0}
.av-j{background-image:var(--jun)}.av-i{background-image:var(--jio)}
.stories{overflow-x:auto;scrollbar-width:none}.stories::-webkit-scrollbar{display:none}
.st{flex:none}.st span{max-width:68px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ring.cf{background:linear-gradient(45deg,#1fd15c,#0aa34a)}
.st.seen .ring{background:#c7c7c7}
.sinp{padding:0 14px 0 18px;align-items:center;gap:14px;height:44px}
.sinp input{flex:1;min-width:0;background:none;border:0;outline:0;color:#fff;font-size:14px;font-family:inherit}
.sinp input::placeholder{color:rgba(255,255,255,.8)}
.sinp span{font-size:22px;cursor:pointer;line-height:1}
#sheart.on{color:#ff3040}
#sheart.hp{animation:hp .35s}
@keyframes hp{50%{transform:scale(1.5)}}
.sent{position:absolute;right:14px;bottom:calc(env(safe-area-inset-bottom,0px) + 68px);z-index:5;background:#3797f0;color:#fff;padding:8px 14px;border-radius:18px 18px 4px 18px;font-size:14px;max-width:260px;opacity:0;transition:opacity .3s;word-break:break-word;pointer-events:none}
.sent.on{opacity:1}
.sinp{left:auto;right:16px;border:0;padding:0;height:auto}
.sinp span{font-size:30px}
#toast{position:absolute;bottom:90px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.75);padding:9px 16px;border-radius:18px;font-size:13px;opacity:0;transition:.3s;pointer-events:none;white-space:nowrap;z-index:9}
#toast.on{opacity:1}
</style>
</head>
<body>
<div id="phone">

<!-- 잠금화면 -->
<div class="scr bg on" id="lock">
  <div class="sb"><span>&nbsp;</span><span class="sr"><svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx=".8"/><rect x="5" y="5.5" width="3" height="6.5" rx=".8"/><rect x="10" y="3" width="3" height="9" rx=".8"/><rect x="15" y="0" width="3" height="12" rx=".8"/></svg><b>5G</b><span class="bt"><em>73</em></span></span></div>
  <div class="clock"><span id="ldate"></span><b id="ltime"></b></div>
  <div class="notis">
    <div class="noti"><div class="h"><span>💬 메시지</span><span>3분 전</span></div><div class="t">安信❤️</div><div>메시지 2개가 도착했습니다</div></div>
    <div class="noti"><div class="h"><span>📞 전화</span><span>4분 전</span></div><div class="t">安信❤️</div><div>부재중 전화 1통</div></div>
  </div>
  <div id="swipe" onclick="showPin()">▲ 눌러서 잠금 해제</div>
  <div class="hb" onclick="showPin()"><i></i></div>
  <div id="pin">
    <h3>비밀번호를 입력하세요</h3>
    <div class="dots" id="dots"><i></i><i></i><i></i><i></i></div>
    <div class="pad" id="pad"></div>
    <small onclick="hidePin()">취소</small>
  </div>
</div>

<!-- 홈 -->
<div class="scr bg" id="home">
  <div class="sb"><span class="clk">9:41</span><span class="sr"><svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx=".8"/><rect x="5" y="5.5" width="3" height="6.5" rx=".8"/><rect x="10" y="3" width="3" height="9" rx=".8"/><rect x="15" y="0" width="3" height="12" rx=".8"/></svg><b>5G</b><span class="bt"><em>73</em></span></span></div>
  <div class="widget"><small>D-DAY</small>🐱+397일</div>
  <div class="grid">
    <div class="app" onclick="go('kk')"><div class="ic i-kk"></div>카카오톡</div>
    <div class="app" onclick="go('ig')"><div class="ic i-ig"></div>인스타그램</div>
    <div class="app" onclick="go('memo')"><div class="ic i-nt"></div>메모장</div>
  </div>
  <div class="dock">
    <div class="app" onclick="go('web')"><div class="ic i-sf"></div></div>
    <div class="app" onclick="toast('메시지는 카카오톡을 이용해 주세요')"><div class="ic i-ms"><span class="badge">2</span></div></div>
    <div class="app" onclick="go('call')"><div class="ic i-ph"><span class="badge">1</span></div></div>
  </div>
