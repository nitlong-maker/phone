}
function send(){
 const i=$('ti'),v=i.value.trim();if(!v)return;
 add('m',v);i.value='';
 const r=reply(v);
 setTimeout(()=>add('o',r),700+Math.min(v.length*50,1100));
 i.focus()}
$('ti').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.isComposing)send()});

const car=$('car'),di=[...$('dti').children];
function upd(){const i=Math.round(car.scrollLeft/(car.clientWidth||1));$('cnt').textContent=(i+1)+'/3';di.forEach((d,j)=>d.classList.toggle('on',j===i));document.querySelector('.ar.l').style.display=i?'flex':'none';document.querySelector('.ar.r').style.display=i<2?'flex':'none'}
car.addEventListener('scroll',upd);
function slide(d){car.scrollBy({left:d*car.clientWidth,behavior:'smooth'})}
let liked=true;
function like(f){liked=f===undefined?!liked:f;$('hbtn').classList.toggle('on',liked)}
const cms=[];
function openCm(){$('cmsheet').classList.add('on');renderCm()}
function closeCm(){$('cmsheet').classList.remove('on')}
function renderCm(){const l=$('cml');l.innerHTML=cms.length?'':'<div class="cme">아직 댓글이 없어요<br>첫 댓글을 남겨보세요</div>';cms.forEach(c=>{const d=document.createElement('div');d.className='cmi';d.innerHTML='<div class="av-m"></div><div><div><b>xinxinlong311</b> <span></span></div><div class="cmt">방금 · 답글 달기</div></div>';d.querySelector('span').textContent=c;l.appendChild(d)});l.scrollTop=l.scrollHeight;$('cmv').textContent=cms.length?'댓글 '+cms.length+'개 모두 보기':''}
function postCm(){const i=$('cin'),t=i.value.trim();if(!t)return;cms.push(t);i.value='';renderCm()}
$('cin').addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.isComposing)postCm()});
$('carw').addEventListener('dblclick',()=>{like(true);const p=$('pop');p.classList.remove('go');void p.offsetWidth;p.classList.add('go')});
function delPost(){$('dlg').classList.remove('on');$('post').style.display='none';$('empty').style.display='block'}

const VB64="";
(function(){const v=$('svid');try{const b=atob(VB64),u=new Uint8Array(b.length);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);v.src=URL.createObjectURL(new Blob([u],{type:'video/mp4'}))}catch(e){v.src='data:video/mp4;base64,'+VB64}
let tried=0;v.addEventListener('error',()=>{if(!tried){tried=1;v.src='data:video/mp4;base64,'+VB64}})})();
const SD={
 anx:{n:'anxinxin_00',tm:'3분 전',a:'av-p',s:[{t:'i',u:'--s1',p:'85% center'},{t:'v',cf:1}]},
 jun:{n:'junnsseeoo',tm:'2시간 전',a:'av-j',s:[{t:'i',u:'--s3'},{t:'i',u:'--s4'}]},
 jio:{n:'jioha0',tm:'29분 전',a:'av-i',s:[{t:'i',u:'--s5',cf:1}]}};
let cu='anx',si=0,st=0,stm=null,paused=false;const LK={};
const bars=()=>document.querySelectorAll('.sbars b');
function bar(x){bars()[si].style.width=Math.min(100,x*100)+'%'}
function showS(){
 const sl=SD[cu].s[si],v=$('svid');clearInterval(stm);st=0;
 bars().forEach((b,j)=>b.style.width=j<si?'100%':'0');
 $('cf').style.display=sl.cf?'flex':'none';$('story').classList.toggle('cfs',!!sl.cf);$('sheart').textContent=LK[cu+si]?'♥':'♡';$('sheart').classList.toggle('on',!!LK[cu+si]);
 if(sl.t==='i'){v.pause();v.style.display='none';$('story').style.setProperty('--cur','var('+sl.u+')');$('simg').style.backgroundPosition=sl.p||'center';$('simg').style.display='block';$('sbg').style.display='block';
  stm=setInterval(()=>{if(paused)return;st+=50;bar(st/5000);if(st>=5000)sNext()},50)}
 else{$('simg').style.display='none';$('sbg').style.display='none';v.style.display='block';
  try{v.currentTime=0}catch(e){}v.muted=false;const p=v.play();if(p&&p.catch)p.catch(()=>{v.muted=true;v.play().catch(()=>{})});
  stm=setInterval(()=>{if(paused)return;st+=50;const ok=v.duration&&!v.error;bar(ok?v.currentTime/v.duration:st/5400);if(!ok&&st>=5400)sNext()},50)}
}
function openStory(k){cu=k;si=0;paused=false;const S=SD[k];$('sbars').innerHTML=S.s.map(()=>'<i><b></b></i>').join('');$('sav').className=S.a;$('sname').textContent=S.n;$('stime').textContent=S.tm;go('story');showS()}
function sLike(){const k=cu+si;LK[k]=!LK[k];const h=$('sheart');h.textContent=LK[k]?'♥':'♡';h.classList.toggle('on',!!LK[k]);h.classList.remove('hp');void h.offsetWidth;h.classList.add('hp');if(LK[k])toast('❤️ 좋아요를 보냈어요')}
function sNext(){if(si<SD[cu].s.length-1){si++;showS()}else closeStory()}
function sPrev(){if(si>0)si--;showS()}
function closeStory(){clearInterval(stm);paused=false;$('svid').pause();$(cu).classList.add('seen');go('ig')}
$('svid').addEventListener('ended',()=>{if(SD[cu].s[si].t==='v')sNext()});
/* 전화 */
let ct=[],cint=null,actx=null;
const LINES=['롱롱 무슨 일이야?','나도 보고싶지','밥 아직 안 먹었어','그럼 같이 먹을까?','알았어 다시 연락할게 사랑해'];
function beep(t0,d){const o=actx.createOscillator(),g=actx.createGain();o.frequency.value=425;o.connect(g);g.connect(actx.destination);g.gain.setValueAtTime(.0001,t0);g.gain.exponentialRampToValueAtTime(.12,t0+.03);g.gain.setValueAtTime(.12,t0+d-.05);g.gain.exponentialRampToValueAtTime(.0001,t0+d);o.start(t0);o.stop(t0+d)}
function later(f,ms){ct.push(setTimeout(f,ms))}
function startCall(){
 endCall(true);go('callscr');
 $('cst').textContent='연결 중...';$('cdur').textContent='';$('csub').className='csub';$('csub').innerHTML='';
 try{const AC=window.AudioContext||window.webkitAudioContext;actx=new AC();beep(actx.currentTime,.8);beep(actx.currentTime+1,.8)}catch(e){}
 later(()=>{
  $('cst').textContent='통화 중';let s=0;$('cdur').textContent='00:00';
  cint=setInterval(()=>{s++;$('cdur').textContent=String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0')},1000);
  LINES.forEach((l,i)=>later(()=>{const c=$('csub');c.className='csub';void c.offsetWidth;c.innerHTML='<small>安信 ♥</small>';c.appendChild(document.createTextNode(l));c.classList.add('on')},800+i*2600));
  later(()=>{$('cst').textContent='통화 종료';$('csub').className='csub';$('csub').innerHTML='';clearInterval(cint)},800+LINES.length*2600);
  later(()=>endCall(),800+LINES.length*2600+1200);
 },2000);
}
function endCall(silent){
 const active=ct.length>0;ct.forEach(clearTimeout);ct=[];clearInterval(cint);
 if(actx){try{actx.close()}catch(e){}actx=null}
 if(silent||!active)return;
 $('clog').insertAdjacentHTML('afterbegin','<div class="row" onclick="startCall()" style="cursor:pointer"><div class="av ph">🧑</div><div><div class="n">安信 ♥</div><div class="s">↗ 발신</div></div><div class="d">방금</div></div>');
 go('call');
}
</script>
</body>
</html>
